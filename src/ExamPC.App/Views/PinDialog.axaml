<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ExamPC.App.Views.PinDialog"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="BorderOnly"
        Topmost="True"
        ShowInTaskbar="False"
        Background="White">

  <Window.Styles>
    <Style Selector="Button.dlg">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,11" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#EEF2F6" />
      <Setter Property="Foreground" Value="#3E4C59" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E1E7ED" />
      <Setter Property="Foreground" Value="#1F2933" />
    </Style>
    <Style Selector="Button.confirm">
      <Setter Property="Background" Value="#1F6F43" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.confirm:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#26834F" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.confirm:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#8DB9A0" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBox#PinBox">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="50" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
  </Window.Styles>

  <!-- Garis aksen hijau di atas, pengganti bingkai jendela yang sengaja disembunyikan. -->
  <Border BorderBrush="#1F6F43" BorderThickness="0,4,0,0">
    <StackPanel Margin="30,26,30,26">

      <Border Width="58" Height="58" CornerRadius="29" Background="#E7F5EC"
              HorizontalAlignment="Center">
        <Path Fill="#1F6F43" Width="26" Height="26" Stretch="Uniform"
              Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" />
      </Border>

      <TextBlock x:Name="TitleLine" FontSize="19" FontWeight="Bold" Foreground="#1F2933"
                 HorizontalAlignment="Center" Margin="0,16,0,0" />
      <TextBlock Text="Khusus pengawas. Masukkan PIN untuk melanjutkan."
                 Foreground="#6B7A8D" FontSize="13" TextWrapping="Wrap"
                 TextAlignment="Center" Margin="0,6,0,0" />

      <TextBox x:Name="PinBox" PasswordChar="●" MaxLength="12" FontSize="22"
               TextAlignment="Center" Watermark="PIN pengawas"
               Margin="0,20,0,0" KeyDown="OnPinKeyDown" />

      <TextBlock x:Name="StatusLine" FontSize="12" IsVisible="False"
                 TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />

      <Grid ColumnDefinitions="*,*" Margin="0,22,0,0">
        <Button Grid.Column="0" Classes="dlg secondary" Content="Batal"
                Click="OnCancel" Margin="0,0,5,0" />
        <Button Grid.Column="1" x:Name="ConfirmButton" Classes="dlg confirm" Content="Konfirmasi"
                Click="OnConfirm" Margin="5,0,0,0" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
