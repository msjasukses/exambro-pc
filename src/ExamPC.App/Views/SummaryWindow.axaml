<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ExamPC.App.Views.SummaryWindow"
        Title="ExamPC — Ringkasan Sesi"
        Width="760" Height="580"
        WindowStartupLocation="CenterScreen"
        Background="#F6F8FA">

  <Grid RowDefinitions="Auto,*,Auto">

    <Border Grid.Row="0" Background="White" Padding="24,18"
            BorderBrush="#DCE3EA" BorderThickness="0,0,0,1">
      <StackPanel Spacing="3">
        <TextBlock Text="Sesi Ujian Selesai" FontSize="20" FontWeight="Bold" Foreground="#1F2933" />
        <TextBlock x:Name="MetaLine" Foreground="#6B7A8D" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="24,16">
      <StackPanel Spacing="8">
        <TextBlock x:Name="HeadlineLine" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ItemsControl x:Name="ViolationList" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="White" BorderBrush="#DCE3EA" BorderThickness="1"
                      CornerRadius="4" Padding="12,9" Margin="0,0,0,6">
                <Grid ColumnDefinitions="90,150,*">
                  <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas,Menlo,monospace"
                             Foreground="#6B7A8D" />
                  <TextBlock Grid.Column="1" Text="{Binding Code}" FontWeight="SemiBold"
                             Foreground="#B4232B" />
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap"
                             Foreground="#1F2933" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="White" Padding="24,14"
            BorderBrush="#DCE3EA" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" x:Name="LogPathLine" VerticalAlignment="Center"
                   Foreground="#6B7A8D" FontSize="12" TextWrapping="Wrap" />
        <Button Grid.Column="1" Content="Siapkan Sesi Berikutnya" Click="OnNewSession"
                Padding="18,9" Margin="0,0,10,0" />
        <Button Grid.Column="2" Content="Tutup Aplikasi" Click="OnQuit" Padding="18,9" />
      </Grid>
    </Border>

  </Grid>
</Window>
